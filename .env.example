PORT=3001
SESSION_SECRET=change-this-to-a-long-random-string

DB_HOST=localhost
DB_USER=coralgold
DB_PASS=your_db_password
DB_NAME=coralgold

# ── Uploaded image storage ───────────────────────────────────────────────
# Without any of these, images are saved inside the app folder and are LOST
# on every redeploy. Pick one:
#
# Option A — fixed persistent folder on the Hostinger file server (this is
# the coralgold.in setup: public_html/Images, served at coralgold.in/images).
# IMAGES_DIR must be the ABSOLUTE path as shown in Hostinger's File Manager /
# SSH — find it via `pwd` inside public_html/Images over SSH, or the path
# shown in File Manager (something like the example below; the u-number is
# specific to this hosting account, get it from hPanel).
# IMAGES_DIR=/home/u123456789/domains/coralgold.in/public_html/Images
# IMAGES_PUBLIC_URL=https://coralgold.in/images
#
# Option B — S3-compatible object storage (most robust; works with AWS S3,
# Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO, etc.). Set all
# three of these to activate it:
# S3_BUCKET=coralgold-images
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT=                 # omit for real AWS S3; required for R2/Spaces/MinIO
# S3_REGION=auto                # e.g. us-east-1 for AWS
# S3_PUBLIC_URL_BASE=           # optional — CDN/custom domain fronting the bucket
# S3_FORCE_PATH_STYLE=1         # needed by most non-AWS S3-compatible services
#
# Legacy fallback (no longer recommended, kept for old deployments):
# UPLOAD_DIR=/home/u123456789/uploads

# Email (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
CONTACT_TO=info@coralgold.in

NODE_ENV=production
