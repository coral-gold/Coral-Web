PORT=3001
SESSION_SECRET=change-this-to-a-long-random-string

DB_HOST=localhost
DB_USER=coralgold
DB_PASS=your_db_password
DB_NAME=coralgold

# ── Uploaded image storage ───────────────────────────────────────────────
# Without either of these, images are saved inside the app folder and are
# LOST on every redeploy. Pick one:
#
# Option A — local disk outside the app folder (simplest):
# UPLOAD_DIR=/home/u123456789/uploads
#
# Option B — S3-compatible object storage (most robust; works with AWS S3,
# Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO, etc.). Set all
# three of these to activate it:
# S3_BUCKET=coralgold-images
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT=                 # omit for real AWS S3; required for R2/Spaces/MinIO
# S3_REGION=auto                # e.g. us-east-1 for AWS
# S3_PUBLIC_URL_BASE=           # optional — CDN/custom domain fronting the bucket
# S3_FORCE_PATH_STYLE=1         # needed by most non-AWS S3-compatible services

# Email (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
CONTACT_TO=info@coralgold.in

NODE_ENV=production
