# Never commit credentials
includes/config.php
.env
server/config.json

# Node
node_modules/
client/node_modules/
# client/dist/ — committed so Hostinger can serve without a build step

# Uploads (runtime)
uploads/

# Uploaded product images (legacy path — kept for any images already there)
assets/uploads/*
!assets/uploads/.gitkeep

# Persistent image storage (Batch 13) — served at https://coralgold.in/images/.
# This folder must NEVER be part of what gets committed/deployed: if the repo
# root is Hostinger's deploy target (public_html), a git-based deploy leaves
# untracked files alone, but confirm in Hostinger's own deploy settings
# whether anything here does a destructive mirror/sync instead — .gitignore
# alone does not protect against that. See README/.env.example for details.
Images/*
!Images/.gitkeep

# Thumbnail cache
assets/thumbs/*
!assets/thumbs/.gitkeep

# OS and editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.bak
