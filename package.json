{
  "name": "coral-web",
  "version": "2.0.0",
  "description": "Coral Gold Wholesale Jewellery Platform",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"nodemon server/index.js\" \"npm run client:dev\"",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
